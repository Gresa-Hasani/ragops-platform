# Copy to `.env` in the repository root and adjust. Never commit `.env`.
# Docker Compose reads it automatically; the backend (run from backend/) reads the
# RAGOPS_* variables from ../.env, optionally overridden by backend/.env.

# --- Docker Compose: PostgreSQL ---
POSTGRES_USER=ragops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragops

# --- Docker Compose: host ports (change if already in use on your machine) ---
POSTGRES_HOST_PORT=5442
QDRANT_HOST_PORT=6333
BACKEND_HOST_PORT=8010

# --- Backend (RAGOPS_ prefix) ---
# local | test | production
RAGOPS_ENVIRONMENT=local
RAGOPS_LOG_LEVEL=INFO
# json | console
RAGOPS_LOG_FORMAT=json
RAGOPS_CORS_ORIGINS=http://localhost:3000

# Used when running the backend outside Docker (inside Compose it is derived from POSTGRES_*).
RAGOPS_DATABASE_URL=postgresql+asyncpg://ragops:change-me@localhost:5442/ragops
RAGOPS_QDRANT_URL=http://localhost:6333
# RAGOPS_QDRANT_API_KEY=

# --- Integration tests (pytest -m integration) ---
RAGOPS_TEST_DATABASE_URL=postgresql+asyncpg://ragops:change-me@localhost:5442/ragops_test
RAGOPS_TEST_QDRANT_URL=http://localhost:6333
